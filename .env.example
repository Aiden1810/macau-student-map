NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_AMAP_WEB_KEY=YOUR_AMAP_WEB_KEY
# 城觅 2.0「附近找店」测试开关，配置后重启开发服务器或重新构建。
NEXT_PUBLIC_NEARBY_SEARCH_ENABLED=false
# 在开发环境应用私人饮食记录迁移后启用。
NEXT_PUBLIC_MEAL_HISTORY_ENABLED=false
# 高德 JS 安全码，仅服务端代理读取。请勿使用 NEXT_PUBLIC_ 前缀。
AMAP_JS_SECURITY_CODE=

# 城觅选店助手：仅服务端读取，不要使用 NEXT_PUBLIC_ 前缀
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
