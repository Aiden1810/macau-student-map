NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_AMAP_WEB_KEY=YOUR_AMAP_WEB_KEY
# 启用 JS API 安全密钥时，将代理开关设为 true，密钥只填服务端变量。
NEXT_PUBLIC_AMAP_USE_SECURITY_PROXY=false
AMAP_JS_SECURITY_CODE=
# 独立的高德 Web 服务类型 Key，供 P1 搜索、地理编码及地点详情使用。
AMAP_WEB_SERVICE_KEY=
# 确认高德授权允许持久化 POI ID 后才启用。
AMAP_ALLOW_POI_ID_PERSISTENCE=false
# 新建高德关联及学生推荐服务端写入使用。仅配置在服务端。
SUPABASE_SERVICE_ROLE_KEY=

# 城觅选店助手：仅服务端读取，不要使用 NEXT_PUBLIC_ 前缀
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
